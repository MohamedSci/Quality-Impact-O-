{
  "name": "Quality Impact OÜ",
  "version": "1.0.0",
  "description": "Quality Impact OÜ - QA-PaaS SaaS Platform Website (www.qa-paas.com)",
  "private": true,
  "license": "PROPRIETARY SOFTWARE LICENSE & EULA",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "next:start": "next start",
    "start": "node start.js",
    "lint": "eslint app components e2e --ext .ts,.tsx --fix",
    "lint:check": "eslint app components e2e --ext .ts,.tsx",
    "type-check": "tsc --noEmit",
    "format": "prettier --write . --ignore-path .gitignore --ignore-unknown",
    "format:check": "prettier --check . --ignore-path .gitignore --ignore-unknown",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:ui": "playwright test --ui",
    "test:a11y": "playwright test e2e/accessibility.spec.ts",
    "qa": "npm run type-check && npm run lint:check && npm run format:check",
    "qa:fix": "npm run lint && npm run format",
    "verify": "npm run build && npm run qa"
  },
  "dependencies": {
    "clsx": "^2.0.0",
    "lucide-react": "^0.378.0",
    "next": "^16.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.8.0",
    "@playwright/test": "^1.40.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^6.1.5",
    "@testing-library/react": "^15.0.0",
    "@types/node": "^20.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.16",
    "eslint": "^8.55.0",
    "eslint-config-next": "^16.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "postcss": "^8.4.31",
    "prettier": "^3.1.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
